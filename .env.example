# Docker Compose: copy to repo root .env (Compose forwards keys into the API container).
# Local API dev: also copy to apps/api/.env and set DATABASE_URL for your Postgres.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/numbers?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=another_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_SEC=604800

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=Numbers Dont Lie <no-reply@localhost>

WEB_APP_URL=http://localhost:5173
PORT=3000
COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_ONLY=false
DELETE_RETENTION_DAYS=30
PURGE_ADMIN_SECRET=replace_with_long_random_secret

# OAuth (optional — leave empty to disable provider buttons in Swagger/UI)
OAUTH_CALLBACK_BASE=http://localhost:3000/api/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Docker Compose reads these from the repository root .env file
# and forwards them into the API / web containers.

# Web UI: Quick actions, API health line, manual reload buttons, raw JSON (review builds)
VITE_DEV_TOOLS=false

# AI insights (optional; if missing, deterministic fallback insights are stored)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Phase 3 wingman bootstrap (see docs/PHASE3_BOOTSTRAP.md)
# Set to false to disable wingman chat entirely
ASSISTANT_ENABLED=true
# anthropic (default) or openai — falls back to OPENAI_API_KEY if Anthropic unset
ASSISTANT_LLM_PROVIDER=anthropic
ASSISTANT_MODEL=claude-sonnet-4-20250514
ASSISTANT_OPENAI_MODEL=gpt-4o-mini
ASSISTANT_RESPONSE_MODE=concise
# SSE streaming for wingman final reply (default true when LLM configured)
ASSISTANT_STREAMING=true
# llm (default) or rule — thread summary after 12+ messages
ASSISTANT_SUMMARY_MODE=llm
# Cross-session user memory (preferences, goals); set false to disable
ASSISTANT_MEMORY_ENABLED=true
ASSISTANT_MEMORY_MIN_NEW_MESSAGES=4
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
MEAL_PHOTO_MAX_BYTES=5242880
# Optional; bootstrap endpoint reports design doc paths in-repo
# AI_ASSISTANT_DESIGN_REPO=
